<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- core prints the payment terms label even when the order has none -->
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='o.payment_term_id']" position="attributes">
            <attribute name="t-if">o.payment_term_id</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.payment_term_id']/preceding-sibling::strong[1]" position="attributes">
            <attribute name="t-if">o.payment_term_id</attribute>
        </xpath>
    </template>

</odoo>
