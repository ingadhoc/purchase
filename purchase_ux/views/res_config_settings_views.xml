<?xml version="1.0"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.ux</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="inside">
                <setting id="skip_bill_file_upload" help="Create vendor bills directly without requiring file upload">
                    <field name="purchase_skip_bill_file_upload"/>
                    <div class="text-muted">
                        Skip the file upload step when creating bills from purchase orders
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
