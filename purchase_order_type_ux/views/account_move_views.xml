<odoo>
    <record id="pot_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form.pot</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <label for="journal_id" position="before">
                <field
                    name="purchase_type_id"
                    invisible="move_type not in ['in_invoice', 'in_refund']"
                    readonly="state != 'draft'"
                />
            </label>
            <xpath expr="//notebook//list//field[@name='sequence']" position="before">
                <field name="account_id" column_invisible="True" />
            </xpath>
        </field>
    </record>
</odoo>
