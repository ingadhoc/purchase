<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <div class="o_setting_box" id="propagate_uom_setting">
                    <div class="o_setting_left_pane">
                        <field name="propagate_uom"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="propagate_uom"/>
                        <div class="text-muted">
                            Use the same unit of measure in picking as the one selected in the purchase order (instead of the default unit of measure of the product).
                        </div>
                    </div>
                </div>
                <div class="o_setting_box" id="use_supplier_currency_setting">
                    <div class="o_setting_left_pane">
                        <field name="use_supplier_currency"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="use_supplier_currency"/>
                        <div class="text-muted">
                            Create the purchase order in the supplier's currency instead of the product currency.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
